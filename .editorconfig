# The shell style, recorded once: shfmt reads these keys (it is run with no
# printer flags, so this file is its whole configuration) and an editor
# honouring EditorConfig writes the same layout. Each project owning shell
# checks it with `shfmt -d` in its `format` target (scripts/shell-check.sh).
root = true

[*.sh]
indent_style = space
indent_size = 2
switch_case_indent = true

# The extensionless shell scripts, by path (the same two .gitattributes pins).
[{scripts/nx,.githooks/pre-push}]
indent_style = space
indent_size = 2
switch_case_indent = true
