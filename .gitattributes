# Shell scripts must stay LF, or Windows checkout (core.autocrlf=true) rewrites
# them to CRLF — which breaks `bash scripts/*.sh` and trips shellcheck (SC1017).
*.sh text eol=lf

# The SDK drift gate compares generated contracts byte-for-byte, and Biome
# formats authored SDK sources as LF. Keep those scoped text formats identical
# on Windows without changing checkout semantics for the rest of the repo.
/npm/oneharness-sdk/**/*.ts text eol=lf
/npm/oneharness-sdk/**/*.js text eol=lf
/npm/oneharness-sdk/**/*.mjs text eol=lf
/npm/oneharness-sdk/**/*.json text eol=lf
