# Shell scripts must stay LF, or Windows checkout (core.autocrlf=true) rewrites
# them to CRLF — which breaks `bash scripts/*.sh` and trips shellcheck (SC1017).
*.sh text eol=lf

# The SDK drift gate compares generated contracts byte-for-byte, and Biome
# formats authored SDK sources as LF. Keep those scoped text formats identical
# on Windows without changing checkout semantics for the rest of the repo.
/npm/oneharness-sdk/**/*.ts text eol=lf
/npm/oneharness-sdk/**/*.js text eol=lf
/npm/oneharness-sdk/**/*.mjs text eol=lf
/npm/oneharness-sdk/**/*.json text eol=lf

# Same reason, for the other two generators that compare their output
# byte-for-byte: the parity audit against `docs/sdk-parity.md`, and the Python
# SDK's contracts against `_generated`. Both write LF, so an unpinned CRLF
# checkout is a stale file no Linux or macOS run can see.
/docs/sdk-parity.md text eol=lf
/python/oneharness-sdk/**/*.py text eol=lf
/python/oneharness-sdk/**/*.json text eol=lf

# The one blob that is CRLF on purpose — what `check-lf-contracts-test.sh`
# drives the gate at. `-text` keeps every layer, this repository's and the
# checkout's alike, from normalizing it in either direction.
/tests/fixtures/crlf-checkout.txt -text
