{
  "name": "github-workflows-integration",
  "projectType": "library",
  "tags": [
    "type:test",
    "lang:javascript"
  ],
  "implicitDependencies": [
    "release-payload-contract"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/.github/project.json",
      "{workspaceRoot}/.github/workflows/release.yml",
      "{workspaceRoot}/.github/workflows/ci.yml",
      "{workspaceRoot}/.github/workflows/e2e-variants.yml",
      "{workspaceRoot}/.github/variants-routing.mjs",
      "{workspaceRoot}/.github/package.json",
      "{workspaceRoot}/.github/bun.lock",
      "{workspaceRoot}/scripts/release-*.mjs",
      "{workspaceRoot}/scripts/npm-build.mjs",
      "{workspaceRoot}/release-platforms.toml",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/crates/oneharness-core/src/**/*",
      "{workspaceRoot}/crates/oneharness-core/Cargo.toml",
      "{workspaceRoot}/src/**/*",
      "{workspaceRoot}/npm/oneharness/**/*",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/README.md",
      "{workspaceRoot}/LICENSE",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/CHANGELOG.md",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/scripts/nx",
      "{workspaceRoot}/.github/gate-env.mjs",
      "{workspaceRoot}/.github/workflow-graph.mjs",
      "{workspaceRoot}/scripts/e2e-lib.sh",
      "{workspaceRoot}/scripts/check-usage-enforce.sh",
      "{workspaceRoot}/scripts/with-portable-sed.sh"
    ]
  },
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --check .github/integration/transfer-journey.mjs && node --check .github/integration/rejection-journey.mjs && node --check .github/integration/journey.mjs && node --check .github/integration/setup-journey.mjs && node --check .github/integration/gate-env-journey.mjs"
      }
    },
    "e2e": {
      "//": "llmlint: ignore-block[external_service_suite_stays_out_of_the_affected_tier] Artifact construction and private workflow-tool setup are integration proofs selected by the files each reads; locked registry setup and local packing/install journeys make no model or paid calls and remain separate from fast workflow tests.",
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "node .github/integration/setup-journey.mjs",
          "node .github/integration/journey.mjs",
          "node .github/integration/gate-env-journey.mjs"
        ],
        "parallel": false
      },
      "//end": "llmlint: ignore-end[external_service_suite_stays_out_of_the_affected_tier]"
    }
  }
}
