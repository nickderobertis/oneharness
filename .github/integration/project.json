{
  "name": "github-workflows-integration",
  "projectType": "library",
  "tags": [
    "type:test",
    "lang:javascript"
  ],
  "implicitDependencies": [
    "release-payload-contract"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/*.mjs",
      "{projectRoot}/project.json",
      "{workspaceRoot}/.github/workflows/release.yml",
      "{workspaceRoot}/.github/package.json",
      "{workspaceRoot}/.github/bun.lock",
      "{workspaceRoot}/scripts/release-*.mjs",
      "{workspaceRoot}/scripts/npm-build.mjs",
      "{workspaceRoot}/release-platforms.toml",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/crates/oneharness-core/src/**/*",
      "{workspaceRoot}/crates/oneharness-core/Cargo.toml",
      "{workspaceRoot}/src/**/*",
      "{workspaceRoot}/npm/oneharness/**/*",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/README.md",
      "{workspaceRoot}/LICENSE",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/CHANGELOG.md",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/config.toml"
    ]
  },
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --check .github/integration/transfer-journey.mjs && node --check .github/integration/rejection-journey.mjs && node --check .github/integration/journey.mjs"
      }
    },
    "e2e": {
      "//": "llmlint: ignore-block[external_service_suite_stays_out_of_the_affected_tier] Release construction is an integration proof selected by the files it reads; the local build, pack and install journey makes no model or paid calls and stays separate from fast workflow tests and from the setup and gate-env journeys, each its own project under this directory.",
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node .github/integration/journey.mjs"
      },
      "//end": "llmlint: ignore-end[external_service_suite_stays_out_of_the_affected_tier]"
    }
  }
}
