/target
**/*.rs.bk
*.pdb

# `just`'s per-recipe scratch dirs (justfile `set tempdir`). The directory IS
# committed (via .gitkeep) so recipes have somewhere to write; its contents are
# not — an interrupted recipe leaves one behind.
/.just-tmp/*
!/.just-tmp/.gitkeep

# Python packaging build outputs (maturin wheels + caches). pyproject.toml IS
# committed; these build artifacts are not.
/dist
__pycache__/
.ruff_cache/
.coverage
*.egg-info/

# Version-stamped Python SDK staging and wheel output.
/python/dist

# npm packaging build outputs (per-platform packages + stamped launcher assembled
# by scripts/npm-build.mjs). npm/oneharness/ IS committed; these are not.
/npm/dist
/npm/oneharness-sdk/dist
node_modules/

# `just`'s tempdir (justfile `set tempdir`). The directory IS committed so a
# clean clone has it; the per-recipe `just-XXXXXX/` scratch it fills with is not,
# and a recipe killed mid-run leaves some behind for the next `git add -A`.
/.just-tmp/*
!/.just-tmp/.gitkeep

# Local secrets synced from Bitwarden (gh-secrets.json -> env_file destination)
# and the manifest sync-state log. The manifest itself IS committed; these aren't.
.env
.env.local
.gh-secrets-state.json
