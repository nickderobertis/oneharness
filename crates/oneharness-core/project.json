{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "oneharness-core",
  "projectType": "library",
  "tags": [
    "type:lib",
    "lang:rust"
  ],
  "//": "The engine. Its unit tests also pin the README, two docs, two live scripts and the CLI's clap source, so those are inputs of its `test` \u2014 which is why a change to any of them reaches the whole graph.",
  "implicitDependencies": [
    "harness-captures"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "rustToolchain"
    ]
  },
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo fmt -p oneharness-core -- --check"
        ],
        "parallel": false
      }
    },
    "format-write": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo fmt -p oneharness-core"
        ],
        "parallel": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo clippy -p oneharness-core --all-targets --features mock-harness --locked -- -D warnings",
          "cargo doc -p oneharness-core --no-deps --quiet --locked"
        ],
        "parallel": false,
        "env": {
          "RUSTDOCFLAGS": "-D warnings"
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo build -p oneharness-core --locked"
        ],
        "parallel": false,
        "env": {
          "RUSTFLAGS": "-D warnings"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bash scripts/cargo-test.sh oneharness-core --features oneharness-core/mock-harness"
        ],
        "parallel": false
      },
      "inputs": [
        "default",
        "^default",
        "rustTestRunner",
        "{workspaceRoot}/README.md",
        "{workspaceRoot}/docs/harness-usage.md",
        "{workspaceRoot}/docs/sdk-parity.md",
        "{workspaceRoot}/scripts/e2e-codex.sh",
        "{workspaceRoot}/scripts/e2e-lib.sh",
        "{workspaceRoot}/src/cli.rs"
      ],
      "outputs": [
        "{workspaceRoot}/target/coverage/oneharness-core.profdata"
      ],
      "parallelism": false
    }
  }
}
