{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "live-codex",
  "projectType": "library",
  "tags": [
    "type:live",
    "lang:bash"
  ],
  "implicitDependencies": [
    "oneharness",
    "install-surface",
    "e2e-support"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/scripts/e2e-codex.sh",
      "{workspaceRoot}/scripts/codex-stall-endpoint.py"
    ]
  },
  "targets": {
    "live": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "just live-codex"
        ],
        "parallel": false
      },
      "cache": false
    }
  }
}
