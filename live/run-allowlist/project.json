{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "live-run-allowlist",
  "projectType": "library",
  "tags": [
    "type:live",
    "lang:python"
  ],
  "implicitDependencies": [
    "oneharness",
    "install-surface",
    "e2e-support"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*"
    ]
  },
  "targets": {
    "live": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "just live-run-allowlist"
        ],
        "parallel": false
      },
      "cache": false
    }
  }
}
