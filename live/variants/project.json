{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "live-variants",
  "projectType": "library",
  "tags": [
    "type:live",
    "lang:bash"
  ],
  "implicitDependencies": [
    "oneharness",
    "install-surface",
    "e2e-support"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/scripts/e2e-variants.sh"
    ]
  },
  "targets": {
    "live": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "just live-variants"
        ],
        "parallel": false
      },
      "cache": false
    }
  }
}
