#!/usr/bin/env bash
# Run Nx the way every gate recipe in the justfile does, rather than calling
# `nx` directly, so:
#
#   * a checkout that has never run `bun install` gets the locked workspace
#     install first (the root bun.lock), instead of "nx: command not found";
#   * Nx runs without its background daemon, Nx Cloud, or the interactive TUI —
#     every invocation is one foreground process that finishes, the same
#     locally and in CI.
#
# Usage: scripts/nx <nx arguments...>
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

export NX_DAEMON=false NX_NO_CLOUD=true NX_TUI=false NX_SKIP_NX_CACHE_WARNING=true

if ! command -v node >/dev/null 2>&1; then
  echo "nx: Nx runs on Node, which is not on PATH; install Node (22, as CI does) and re-run." >&2
  exit 1
fi
if ! command -v just >/dev/null 2>&1; then
  echo "nx: just is not on PATH; it runs the locked workspace install ('just js-install'). Install just (.tool-versions pins it) and re-run." >&2
  exit 1
fi
if ! command -v bun >/dev/null 2>&1; then
  echo "nx: bun is not on PATH; it installs Nx from the root bun.lock. Install bun (https://bun.sh) and re-run 'just bootstrap'." >&2
  exit 1
fi

stamp=node_modules/.bun-install-stamp
if [ ! -f node_modules/nx/package.json ] || [ ! -f "$stamp" ] || [ bun.lock -nt "$stamp" ] || [ package.json -nt "$stamp" ]; then
  # The justfile's `js-install` is the one implementation of the locked install
  # (quiet on success, bun's own reason on failure); this only decides when.
  if ! just --justfile "$root/justfile" --working-directory "$root" js-install; then
    echo "nx: the locked workspace install failed (above); fix it, then re-run 'just bootstrap'." >&2
    exit 1
  fi
  touch "$stamp"
fi

# The entry point is whatever the installed package's own `bin` field names.
nx_bin="$(node -e 'const p = require.resolve("nx/package.json"); process.stdout.write(require("path").join(p, "..", require(p).bin.nx))')"

# Outside a terminal Nx ends a failed run with "full log: <path>" per failed task
# (on stderr) instead of its output — a path on whichever machine ran it, which
# a CI log reader cannot open. So a failed run prints those logs here, after the
# summary, to stderr. Only stderr passes through the copy that finds them: the
# descriptor swap keeps Nx's stdout (`show projects --json`, say) its own.
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
status=0
{ node "$nx_bin" "$@" 2>&1 1>&3 3>&- | tee "$log" >&2 3>&-; } 3>&1 || status=$?
if [ "$status" -ne 0 ]; then
  # A "full log:" path is text from a subprocess's stderr, so it is read only
  # when it resolves (symlinks and `..` followed) to the very file Nx itself
  # would write that task's output to in this workspace, and not through a link
  # to somewhere else. That file is what Nx's own `terminalOutputPathForHash`
  # returns for the path's last segment as the hash, and that
  # function is the one source of the layout (`<cacheDir>/terminalOutputs/<hash>`,
  # cacheDir from nx.json or NX_CACHE_DIRECTORY), so nothing here restates it,
  # and a path anywhere else is named and refused rather than read. Node does
  # the resolving so a Windows drive path compares the way Nx wrote it, and it
  # never throws: every failure is a verdict below, so the replay cannot replace
  # Nx's exit status with its own.
  if ! sed -n 's/^[[:space:]]*full log: //p' "$log" | node -e '
    const fs = require("fs"), path = require("path");
    const real = (p) => { try { return fs.realpathSync(p); } catch { return null; } };
    const isFile = (p) => { try { return fs.statSync(p).isFile(); } catch { return false; } };
    let logFor = null, area = "", broken = "";
    try {
      logFor = require("nx/src/tasks-runner/terminal-output-path").terminalOutputPathForHash;
      area = path.dirname(logFor("hash"));
    } catch (error) {
      broken = String(error && error.message ? error.message : error).split("\n")[0];
    }
    for (const named of fs.readFileSync(0, "utf8").split(/\r?\n/).filter(Boolean)) {
      const p = real(named);
      // The area resolved, the hash not: a symlink planted in the area under
      // a hash-like name resolves elsewhere, so it cannot match.
      const own = logFor && logFor(path.basename(named));
      const expected = own && real(path.dirname(own)) ? path.join(real(path.dirname(own)), path.basename(own)) : null;
      const verdict = !logFor ? "unlocated" : !p ? "missing" : p === expected && isFile(p) ? "ok" : "outside";
      process.stdout.write([verdict, verdict === "ok" ? p : named, broken || area].join("\t") + "\n");
    }' | while IFS=$'\t' read -r verdict task_log detail; do
    rerun='re-run the failed task above alone (scripts/nx run <project>:<target>) to see its output.'
    case "$verdict" in
      ok)
        printf '\n----- %s -----\n' "$task_log" >&2
        cat "$task_log" >&2
        ;;
      outside)
        printf '\nnx: the task log %s is not a file in this workspace'"'"'s Nx task-log area (%s), so it is not read; %s\n' "$task_log" "$detail" "$rerun" >&2
        ;;
      unlocated)
        printf '\nnx: the task log %s is not read: the installed Nx did not say where it keeps task logs (%s); run '"'"'just js-install'"'"', then %s\n' "$task_log" "$detail" "$rerun" >&2
        ;;
      *)
        printf '\nnx: the task log %s is not readable on this machine; %s\n' "$task_log" "$rerun" >&2
        ;;
    esac
  done; then
    echo "nx: replaying the failed tasks' logs failed (above); the run's own result stands — re-run a failed task alone (scripts/nx run <project>:<target>) to see its output." >&2
  fi
fi
exit "$status"
