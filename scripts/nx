#!/usr/bin/env bash
# Run Nx the way every gate recipe in the justfile does, rather than calling
# `nx` directly, so:
#
#   * a checkout that has never run `bun install` gets the locked workspace
#     install first (the root bun.lock), instead of "nx: command not found";
#   * Nx runs without its background daemon, Nx Cloud, or the interactive TUI —
#     every invocation is one foreground process that finishes, the same
#     locally and in CI.
#
# Usage: scripts/nx <nx arguments...>
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

export NX_DAEMON=false NX_NO_CLOUD=true NX_TUI=false NX_SKIP_NX_CACHE_WARNING=true

if ! command -v node >/dev/null 2>&1; then
  echo "nx: Nx runs on Node, which is not on PATH; install Node (22, as CI does) and re-run." >&2
  exit 1
fi
if ! command -v just >/dev/null 2>&1; then
  echo "nx: just is not on PATH; it runs the locked workspace install ('just js-install'). Install just (.tool-versions pins it) and re-run." >&2
  exit 1
fi
if ! command -v bun >/dev/null 2>&1; then
  echo "nx: bun is not on PATH; it installs Nx from the root bun.lock. Install bun (https://bun.sh) and re-run 'just bootstrap'." >&2
  exit 1
fi

stamp=node_modules/.bun-install-stamp
if [ ! -f node_modules/nx/package.json ] || [ ! -f "$stamp" ] || [ bun.lock -nt "$stamp" ] || [ package.json -nt "$stamp" ]; then
  # The justfile's `js-install` is the one implementation of the locked install
  # (quiet on success, bun's own reason on failure); this only decides when.
  if ! just --justfile "$root/justfile" --working-directory "$root" js-install; then
    echo "nx: the locked workspace install failed (above); fix it, then re-run 'just bootstrap'." >&2
    exit 1
  fi
  touch "$stamp"
fi

# The entry point is whatever the installed package's own `bin` field names.
nx_bin="$(node -e 'const p = require.resolve("nx/package.json"); process.stdout.write(require("path").join(p, "..", require(p).bin.nx))')"

# Outside a terminal Nx ends a failed run with "full log: <path>" per failed task
# (on stderr) instead of its output — a path on whichever machine ran it, which
# a CI log reader cannot open. So a failed run prints those logs here, after the
# summary, to stderr. Only stderr passes through the copy that finds them: the
# descriptor swap keeps Nx's stdout (`show projects --json`, say) its own.
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
status=0
{ node "$nx_bin" "$@" 2>&1 1>&3 3>&- | tee "$log" >&2 3>&-; } 3>&1 || status=$?
if [ "$status" -ne 0 ]; then
  # A "full log:" path is subprocess output, so it is read only when it is the
  # path the installed Nx's own `terminalOutputPathForHash` names for that hash
  # and it lies physically where that path says: no link anywhere between the
  # trusted anchor — this workspace, or a cache directory configured outside it
  # — and the file. Any other path is named and refused. Node reads and replays
  # it, so no filename passes back through the shell, and a failed replay never
  # replaces Nx's status.
  if ! sed -n 's/^[[:space:]]*full log: //p' "$log" | node -e '
    const fs = require("fs"), path = require("path");
    const say = (text) => process.stderr.write(text);
    const kind = (p) => { try { const st = fs.lstatSync(p); return st.isSymbolicLink() ? "link" : st.isFile() ? "file" : "other"; } catch { return "absent"; } };
    const rerun = "re-run the failed task above alone (scripts/nx run <project>:<target>) to see its output.";
    let logFor = null, broken = "";
    try {
      logFor = require("nx/src/tasks-runner/terminal-output-path").terminalOutputPathForHash;
    } catch (error) {
      broken = String(error && error.message ? error.message : error).split("\n")[0];
    }
    for (const named of fs.readFileSync(0, "utf8").split(/\r?\n/).filter(Boolean)) {
      if (!logFor) {
        say("\nnx: the task log " + named + " is not read: the installed Nx did not say where it keeps task logs (" + broken + "); run just js-install, then " + rerun + "\n");
        continue;
      }
      const own = logFor(path.basename(named));
      const isOwn = path.resolve(named) === path.resolve(own);
      if (isOwn && kind(own) === "absent") {
        say("\nnx: the task log " + named + " is not readable on this machine; " + rerun + "\n");
        continue;
      }
      const cacheDir = path.resolve(path.dirname(path.dirname(own)));
      const workspace = path.resolve(".");
      const inWorkspace = !path.relative(workspace, cacheDir).startsWith("..") && !path.isAbsolute(path.relative(workspace, cacheDir));
      const anchor = inWorkspace ? workspace : cacheDir;
      let physical = null, expected = null;
      try {
        physical = fs.realpathSync(own);
        expected = path.join(fs.realpathSync(anchor), path.relative(anchor, path.resolve(own)));
      } catch {}
      const authorized = isOwn && kind(own) === "file" && physical !== null && physical === expected;
      if (!authorized) {
        say("\nnx: the task log " + named + " is not a file in this workspace" + String.fromCharCode(39) + "s Nx task-log area (" + path.dirname(own) + "), so it is not read; " + rerun + "\n");
        continue;
      }
      let content;
      try {
        content = fs.readFileSync(own);
      } catch (error) {
        say("\nnx: the task log " + named + " is Nx" + String.fromCharCode(39) + "s own but could not be read (" + (error && error.message ? error.message : error) + "); " + rerun + "\n");
        continue;
      }
      say("\n----- " + path.resolve(own) + " -----\n");
      say(content);
    }'; then
    echo "nx: replaying the failed tasks' logs failed (above); the run's own result stands — re-run a failed task alone (scripts/nx run <project>:<target>) to see its output." >&2
  fi
fi
exit "$status"
