{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "oneharness",
  "projectType": "library",
  "tags": [
    "type:app",
    "lang:rust"
  ],
  "//": "The published binary crate and its unit tests. Its manifest stays at the repository root (cargo install --git, maturin and the release matrix name it there), so this project is rooted at src/: a project rooted at the repository root would own every file no other project owns, and every script or document edit would rebuild everything that depends on the binary. The crate's integration tests are the oneharness-integration project.",
  "implicitDependencies": [
    "oneharness-core",
    "mock-responder"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "rustToolchain"
    ]
  },
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo fmt -p oneharness -- --check"
        ],
        "parallel": false
      }
    },
    "format-write": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo fmt -p oneharness"
        ],
        "parallel": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo clippy -p oneharness --lib --bins --features mock-harness --locked -- -D warnings"
        ],
        "parallel": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo build -p oneharness --locked"
        ],
        "parallel": false,
        "env": {
          "RUSTFLAGS": "-D warnings"
        }
      },
      "outputs": [
        "{workspaceRoot}/target/debug/oneharness",
        "{workspaceRoot}/target/debug/oneharness.exe"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bash scripts/cargo-test.sh oneharness --features oneharness/mock-harness --filter \"kind(lib) | kind(bin)\""
        ],
        "parallel": false
      },
      "inputs": [
        "default",
        "^default",
        "rustTestRunner"
      ],
      "outputs": [
        "{workspaceRoot}/target/coverage/oneharness.profdata"
      ],
      "parallelism": false
    }
  }
}
