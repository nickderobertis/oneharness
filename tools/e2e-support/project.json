{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "e2e-support",
  "projectType": "library",
  "tags": [
    "type:live-support",
    "lang:bash"
  ],
  "//": "llmlint: ignore-file[e2e_not_mocked] Every target here is a hermetic test of a live-tier helper, not a product e2e test; scripts/check-codex-feature-flag-order.sh's fake codex is backed by oh_codex_feature_flag_order in scripts/e2e-codex.sh against real codex. JSON allows no narrower scope. What the live suites share \u2014 scripts/e2e-lib.sh \u2014 and the hermetic tests that hold its helpers and the probes' tables to the registry without a credential or a model call. Deterministic, so in the gate. Every live and exploration script is still shellchecked in the gate by the `scripts` project, which keeps their code linted while the suites themselves stay out of it.",
  "implicitDependencies": [
    "oneharness",
    "oneharness-mock-harness",
    "harness-captures"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/scripts/e2e-lib.sh",
      "{workspaceRoot}/scripts/check-usage-enforce.sh",
      "{workspaceRoot}/scripts/check-control-enforce.sh",
      "{workspaceRoot}/scripts/check-qwen-context-free.sh",
      "{workspaceRoot}/scripts/check-copilot-login-probe.sh",
      "{workspaceRoot}/scripts/check-codex-usage-schema.sh",
      "{workspaceRoot}/scripts/check-codex-usage-schema-test.sh",
      "{workspaceRoot}/scripts/check-codex-feature-flag-order.sh",
      "{workspaceRoot}/scripts/check-control-probes.sh",
      "{workspaceRoot}/scripts/check-control-probe-http.sh",
      "{workspaceRoot}/scripts/e2e-variants-test.sh",
      "{workspaceRoot}/scripts/e2e-variants-provider-double.sh",
      "{workspaceRoot}/scripts/e2e-variants-invalid-report-double.sh",
      "{workspaceRoot}/scripts/e2e-netshim.sh",
      "{workspaceRoot}/scripts/e2e-claude.sh",
      "{workspaceRoot}/scripts/e2e-codex.sh",
      "{workspaceRoot}/scripts/e2e-opencode.sh",
      "{workspaceRoot}/scripts/e2e-goose.sh",
      "{workspaceRoot}/scripts/e2e-qwen.sh",
      "{workspaceRoot}/scripts/e2e-crush.sh",
      "{workspaceRoot}/scripts/e2e-copilot.sh",
      "{workspaceRoot}/scripts/e2e-cursor.sh",
      "{workspaceRoot}/scripts/e2e-schema.sh",
      "{workspaceRoot}/scripts/e2e-control.sh",
      "{workspaceRoot}/scripts/e2e-variants.sh",
      "{workspaceRoot}/.github/variants-routing.mjs",
      "{workspaceRoot}/.github/workflows/ci.yml",
      "{workspaceRoot}/.github/workflows/e2e-variants.yml",
      "{workspaceRoot}/scripts/live-variants-tools-e2e.sh",
      "{workspaceRoot}/scripts/explore-control.sh",
      "{workspaceRoot}/scripts/explore-cursor-stdin.sh",
      "{workspaceRoot}/scripts/explore-events.sh",
      "{workspaceRoot}/scripts/explore-hooks.sh",
      "{workspaceRoot}/scripts/explore_control.py",
      "{workspaceRoot}/scripts/codex-stall-endpoint.py",
      "{workspaceRoot}/scripts/with-portable-sed.sh"
    ]
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bash scripts/shell-test.sh e2e-support scripts/with-portable-sed.sh scripts/check-codex-usage-schema.sh",
          "bash scripts/shell-test.sh e2e-support scripts/with-portable-sed.sh scripts/check-codex-usage-schema-test.sh",
          "bash scripts/shell-test.sh e2e-support scripts/with-portable-sed.sh scripts/check-codex-feature-flag-order.sh",
          "bash scripts/shell-test.sh e2e-support scripts/with-portable-sed.sh scripts/check-usage-enforce.sh",
          "bash scripts/shell-test.sh e2e-support scripts/with-portable-sed.sh scripts/check-control-probes.sh",
          "bash scripts/shell-test.sh e2e-support scripts/with-portable-sed.sh scripts/check-control-probe-http.sh",
          "bash scripts/shell-test.sh e2e-support scripts/with-portable-sed.sh scripts/check-control-enforce.sh",
          "bash scripts/shell-test.sh e2e-support scripts/with-portable-sed.sh scripts/check-qwen-context-free.sh",
          "bash scripts/shell-test.sh e2e-support scripts/with-portable-sed.sh scripts/check-copilot-login-probe.sh",
          "bash scripts/shell-test.sh e2e-support scripts/with-portable-sed.sh scripts/e2e-variants-test.sh"
        ],
        "parallel": false
      },
      "dependsOn": [
        "oneharness:build",
        "oneharness-mock-harness:build"
      ],
      "outputs": [
        "{workspaceRoot}/target/coverage/shell/e2e-support"
      ],
      "inputs": [
        "default",
        "^default",
        "shellTestRunner"
      ]
    }
  }
}
