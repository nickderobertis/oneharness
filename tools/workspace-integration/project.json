{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "workspace-integration",
  "projectType": "library",
  "tags": [
    "type:workspace",
    "lang:bash"
  ],
  "//": "The repository-wide suites that drive real host tools rather than stubbed ones, split from `workspace`'s offline tests so an edit to an unrelated hygiene script never pays for them: the affected tier's base derivation driven through the real `just check`, the self-sufficient workspace install driven through the real justfile and scripts/nx, the boundary check's refusals, proven by Nx computing each graph for real over a scratch copy of the tree, the build recipes' failure diagnostics, proven through real just and cargo runs, and the LF gate's refusals, proven by real git checkouts of scratch repositories under Windows conversion rules. Its inputs are what those runs read.",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/scripts/nx-base.sh",
      "{workspaceRoot}/scripts/check-nx-base.sh",
      "{workspaceRoot}/scripts/check-js-install.sh",
      "{workspaceRoot}/scripts/setup-llmlint.sh",
      "{workspaceRoot}/scripts/check-nx-graph-test.sh",
      "{workspaceRoot}/scripts/check-nx-graph.mjs",
      "{workspaceRoot}/scripts/check-build-mock-harness.sh",
      "{workspaceRoot}/scripts/check-lf-contracts.sh",
      "{workspaceRoot}/scripts/check-lf-contracts-test.sh",
      "{workspaceRoot}/tests/fixtures/crlf-checkout.txt",
      "{workspaceRoot}/.gitattributes",
      "{workspaceRoot}/docs/sdk-parity.md",
      "{workspaceRoot}/python/oneharness-sdk/**/*.py",
      "{workspaceRoot}/python/oneharness-sdk/**/*.json",
      "{workspaceRoot}/scripts/with-portable-sed.sh",
      "{workspaceRoot}/scripts/nx",
      "{workspaceRoot}/tools/workspace/boundaries.json",
      "{workspaceRoot}/AGENTS.md",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/crates/*/Cargo.toml",
      "{workspaceRoot}/**/project.json"
    ]
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bash scripts/shell-test.sh workspace-integration scripts/with-portable-sed.sh scripts/check-nx-base.sh",
          "bash scripts/shell-test.sh workspace-integration scripts/with-portable-sed.sh scripts/check-js-install.sh",
          "bash scripts/shell-test.sh workspace-integration scripts/with-portable-sed.sh scripts/check-nx-graph-test.sh",
          "bash scripts/shell-test.sh workspace-integration scripts/with-portable-sed.sh scripts/check-build-mock-harness.sh",
          "bash scripts/shell-test.sh workspace-integration scripts/with-portable-sed.sh scripts/check-lf-contracts-test.sh"
        ],
        "parallel": false
      },
      "outputs": [
        "{workspaceRoot}/target/coverage/shell/workspace-integration"
      ],
      "inputs": [
        "default",
        "^default",
        "shellTestRunner"
      ]
    }
  }
}
